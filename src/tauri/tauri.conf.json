{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotapps",
  "version": "0.1.0",
  "identifier": "com.dotapps.app",
  "build": {
    "beforeDevCommand": null,
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../web" },
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dotapps",
        "width": 720,
        "height": 440,
        "minWidth": 720,
        "minHeight": 440,
        "maxWidth": 720,
        "maxHeight": 440,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "resizable": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' http://localhost:*; script-src 'self' 'unsafe-inline' http://localhost:*; style-src 'self' 'unsafe-inline' http://localhost:*; img-src 'self' data: http://localhost:*; connect-src 'self' http://localhost:* ws://localhost:*; frame-src http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "",
    "externalBin": ["binaries/cloudflared"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Run React/Next.js projects locally with zero setup. dotapps lets non-technical users run web projects from git repositories without requiring Node.js, npm, or terminal knowledge.",
    "shortDescription": "One-click local dev environments",
    "targets": "all",
    "resources": {
      "resources/*": "resources/",
      "resources/linux/*": "resources/linux/",
      "resources/windows/*": "resources/windows/",
      "icons/tray-icon*.png": "icons/"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "providerShortName": null,
      "infoPlist": "Info.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://openable.dev/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyMDBCNUUxM0RBMDNFNDUKUldSRlBxQTk0YlVBQXZHajNmTkVRMWRkS0JkL2lMWk9WUEdqcVZPa3BJQldqZFhzaFNVWml0WWMK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["dotapps"]
      }
    }
  }
}
