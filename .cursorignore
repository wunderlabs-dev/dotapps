# .cursorignore: blocks Cursor agent + Tab from reading or editing these files.
# Use this for files the agent should never directly modify.
# Terminal commands and MCP servers bypass this list.

# Generated specta bindings: regenerated by make, never edit by hand.
src/web/gen/

# Lockfiles: only modify via the package manager.
pnpm-lock.yaml
package-lock.json
Cargo.lock

# Husky git hooks staging dir.
.husky/_/

# Local OS noise.
.DS_Store
